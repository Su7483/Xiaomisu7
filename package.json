{
  "name": "personal-page",
  "version": "1.0.0",
  "description": "小米 SU7 宣传页：零依赖极简一屏版 + Three.js 三维滚动体验版",
  "main": "main.js",
  "scripts": {
    "vendor": "node scripts/copy-vendor.mjs",
    "build:site": "npm run build && node scripts/build-site.mjs",
    "build": "npm run vendor && esbuild src/experience.js --bundle --format=iife --target=es2020 --minify --legal-comments=none --define:import.meta.url=__SU7_BASE__ --outfile=runtime/bundle.js",
    "build:dev": "npm run vendor && esbuild src/experience.js --bundle --format=iife --target=es2020 --sourcemap --define:import.meta.url=__SU7_BASE__ --outfile=runtime/bundle.js",
    "watch": "esbuild src/experience.js --bundle --format=iife --target=es2020 --sourcemap --define:import.meta.url=__SU7_BASE__ --outfile=runtime/bundle.js --watch",
    "start": "node server.mjs --open"
  },
  "keywords": [
    "three.js",
    "webgl",
    "gsap",
    "lenis"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
